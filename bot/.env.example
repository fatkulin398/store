# Скопируйте этот файл в .env и заполните.

# Токен от @BotFather
BOT_TOKEN=

# Адрес сайта (GitHub Pages), обязательно https://
# Пример: https://ваш-логин.github.io/store/
WEBAPP_URL=

# Куда присылать заказы: ваш ID или ID группы менеджеров.
# Узнать: напишите боту /id в нужном чате.
ADMIN_CHAT_ID=
