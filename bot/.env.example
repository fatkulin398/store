# На Railway эти значения вписываются во вкладку Variables, файл .env не нужен.

# Токен от @BotFather
BOT_TOKEN=

# Адрес сайта, обязательно https://
WEBAPP_URL=https://fatkulin398.github.io/store/

# Куда присылать заказы: ваш ID или ID группы менеджеров (узнать: /id в нужном чате)
ADMIN_CHAT_ID=

# Пароль для входа в админ-панель (придумайте длинный)
ADMIN_PASSWORD=

# Ключ GitHub для редактирования каталога из админ-панели
# (fine-grained token: доступ только к репозиторию store, Contents: Read and write)
GITHUB_TOKEN=
GITHUB_REPO=fatkulin398/store

# Папка для базы заказов. На Railway подключите Volume и укажите его путь, например /data
DATA_DIR=/data

# С каких сайтов можно обращаться к API (через запятую). * — с любых
ALLOWED_ORIGINS=*
